<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this exists only so the window has the
         console's page colour from the first frame instead of white.
         1.8.0 — an AppCompat theme (still the dark Material base underneath):
         on Android 8.0 and 8.1 the fingerprint prompt of the new app lock is
         the biometric library's own AppCompat dialog, which closes the
         application on any other theme. -->
    <style name="Theme.NexoraConsole" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
    </style>
</resources>
